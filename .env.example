DATA_DIR=./data
PORT=4000

# Ollama base URL as seen by the PersonAI API process.
# Desktop / native API (default): loopback to a host-installed Ollama
OLLAMA_HOST=http://127.0.0.1:11434
# Also probed automatically: http://localhost:11434
#
# --- Docker Compose / VPS ---
# Prefer an existing host Ollama (default compose path). Do NOT start a second
# Ollama container on :11434 — the `ollama` service is behind profile
# `bundled-ollama` and stays off unless you opt in.
#
# API container → host Ollama (Linux needs extra_hosts host-gateway; already in compose):
#   OLLAMA_HOST=http://host.docker.internal:11434
#   # leave COMPOSE_PROFILES unset / empty
#   docker compose up -d --build
#   # or: docker compose up api -d --build
#
# Opt-in bundled Ollama in Docker (binds host :11434):
#   OLLAMA_HOST=http://ollama:11434
#   COMPOSE_PROFILES=bundled-ollama
#   docker compose --profile bundled-ollama up -d --build
#
# Optional: public/browser-facing URL (install.sh). Not required for desktop.
# OLLAMA_PUBLIC_HOST=http://127.0.0.1:11434
# PERSONAI_OLLAMA_MODE=existing-native
# COMPOSE_PROFILES=

OLLAMA_VISION_MODEL=maternion/LightOnOCR-2
OLLAMA_REASONING_MODEL=deepseek-r1:8b
NEXT_PUBLIC_API_URL=http://localhost:4000
LICENSE_TIER=pro
