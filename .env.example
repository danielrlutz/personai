DATA_DIR=./data
# Structured file logs (gitignored): logs/{info,warning,error}/
LOG_DIR=./logs
PORT=4000
# Web host port (install.sh / docker-compose.override.yml — not read by base compose)
PERSONAI_WEB_PORT=3000
# Prisma path (install.sh sets from DATA_DIR; Docker uses file:/app/data/profiles/bootstrap/personai.db)
DATABASE_URL=file:./data/profiles/bootstrap/personai.db

# --- Auth / encryption ---
# Per-profile passwords (Argon2id) + AES-256-GCM sealed SQLite (personai.db.enc).
# Set passwords in the UI (/profiles/ and Settings). No plaintext passwords in env.
# Profile display name cap at signup (default 12 — fits phone header; max 32):
# PROFILE_NAME_MAX_LENGTH=12
# Integration tests may use: PERSONAI_TEST_PASSWORD=...
# Sessions: data/sessions.json (Bearer tokens). API lock is always on — no mock bypass.

# Ollama base URL as seen by the PersonAI API process.
# Desktop / native API (default): loopback to a host-installed Ollama
OLLAMA_HOST=http://127.0.0.1:11434
# Also probed automatically: http://localhost:11434
#
# --- Docker Compose / VPS ---
# Prefer an existing host Ollama (default). Base compose has NO ollama service.
# Bundled Docker Ollama is a separate file: docker-compose.ollama.yml
#
# API container → host Ollama (Linux needs extra_hosts host-gateway; already in compose):
#   OLLAMA_HOST=http://host.docker.internal:11434
#   COMPOSE_PROFILES=          # must stay empty / unset
#   docker compose up -d --build
#   # or: docker compose up api -d --build
#   # or: ./scripts/vps-up.sh
#
# Opt-in bundled Ollama in Docker (binds host :11434) — only if host has no Ollama:
#   OLLAMA_HOST=http://ollama:11434
#   docker compose -f docker-compose.yml -f docker-compose.ollama.yml up -d --build
#
# If an old install left COMPOSE_PROFILES=bundled-ollama, clear it:
#   grep COMPOSE_PROFILES .env
#   sed -i 's/^COMPOSE_PROFILES=.*/COMPOSE_PROFILES=/' .env
#
# Never set COMPOSE_FILE to include docker-compose.ollama.yml unless you want
# bundled Docker Ollama. A stale COMPOSE_FILE= in .env is a common VPS footgun.
#   sed -i '/^COMPOSE_FILE=/d' .env
#
# Optional: public/browser-facing URL (install.sh). Not required for desktop.
# OLLAMA_PUBLIC_HOST=http://127.0.0.1:11434
# PERSONAI_OLLAMA_MODE=existing-native
COMPOSE_PROFILES=

# Bootstrap only — Settings → Product vault wins after first save (no user .env for day-to-day).
OLLAMA_VISION_MODEL=maternion/LightOnOCR-2:latest
OLLAMA_REASONING_MODEL=deepseek-r1:8b
OLLAMA_ARCHITECT_MODEL=deepseek-r1:14b
# Forge: instruct-q5 preferred, failover to qwen2.5-coder:14b then deepseek-r1:8b
OLLAMA_CODER_MODEL=qwen2.5-coder:14b-instruct-q5_K_M
OLLAMA_COACHING_MODEL=llama3.1:8b
OLLAMA_STYLIST_MODEL=gemma4:e4b
# QA Auditor — deepseek-r1 (not mistral)
OLLAMA_QA_MODEL=deepseek-r1:8b
# Vision/chat request timeouts (ms). Multipage bulks OCR page-by-page under one VRAM lock.
# OLLAMA_VISION_TIMEOUT_MS=180000
# OLLAMA_CHAT_TIMEOUT_MS=180000
# PDF rasterization for scanned Genius Scan / ADF uploads (API image includes PyMuPDF + poppler).
# INGEST_PDF_DPI=140
# INGEST_MAX_PAGES=40
# Browser-facing API URL (baked into the web image at build time). No trailing slash.
# Local desktop/browser on the same machine:
#   NEXT_PUBLIC_API_URL=http://localhost:4000
# Phone / Tailscale MagicDNS (prefer full FQDN — short names often break on Android):
#   HTTP browse-only (Chrome will NOT Install app / PWA):
#     NEXT_PUBLIC_API_URL=http://your-host.tailXXXX.ts.net:4000
#     PUBLIC_WEB_URL=http://your-host.tailXXXX.ts.net:3000
#     ./scripts/vps-tailscale.sh your-host.tailXXXX.ts.net
#   HTTPS via Tailscale Serve (PWA-installable):
#     NEXT_PUBLIC_API_URL=https://your-host.tailXXXX.ts.net:8443
#     PUBLIC_API_URL=https://your-host.tailXXXX.ts.net:8443
#     PUBLIC_WEB_URL=https://your-host.tailXXXX.ts.net
#     HTTPS=1 ./scripts/vps-tailscale.sh your-host.tailXXXX.ts.net
# Settings → API Server can override at runtime on the phone (localStorage).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side OAuth redirects and archive links (Tailscale example in comments above)
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
# PERSONAI_TAILSCALE_HTTPS=1
LICENSE_TIER=pro

# --- Soul News (optional Home widget feed) ---
# PersonAI API proxies GET /integrations/soul-news/feed → {SOUL_NEWS_URL}/v1/feed
# GET /integrations/soul-news/brief → Jarvis brief with desk context (Fristen, tasks)
# Default matches soul-news PORT (8787). Docker API → host sidecar:
#   SOUL_NEWS_URL=http://host.docker.internal:8787
SOUL_NEWS_URL=http://127.0.0.1:8787
# Optional shared secret (must match soul-news PERSONAI_CONTEXT_TOKEN)
# SOUL_NEWS_CONTEXT_TOKEN=

# --- Agent Debug (optional balcony/phone → Cursor MCP inbox) ---
# docker compose --profile agent-debug up -d --build agent-debug
# Phone: http://your-laptop.tailXXXX.ts.net:8790  (set token in UI)
# AGENT_DEBUG_TOKEN=
# AGENT_DEBUG_COMPOSE_MODEL=llama3.1:8b
# AGENT_DEBUG_BATCH_TIMEOUT_MS=90000
# AGENT_DEBUG_VPS_HOST=your-host.tailXXXX.ts.net
# AGENT_DEBUG_PROFILE_HINT=
# AGENT_DEBUG_CONTEXT_HINT=
# AGENT_DEBUG_URL=http://127.0.0.1:8790
# COMPOSE_SKIP_THRESHOLD_CHARS=120
# COMPOSE_MINIMAL_MODE=true


# --- install.sh metadata (optional) ---
# PERSONAI_DOMAIN=app.example.com
# PERSONAI_TLS=yes
# PERSONAI_USE_PROD=1

# --- Google Drive archive (optional) ---
# When unset / not configured, confirmations still write to the local taxonomy
# archive under data/profiles/{id}/archive/{NN_Category}/ — never invents Drive files.
# GOOGLE_DRIVE_ENABLED=true
# Service account (headless). Docker Compose only mounts ./data → /app/data — use a
# path under /app/data/... or INLINE (host ./secrets/... is not visible in the api container).
# GOOGLE_SERVICE_ACCOUNT_JSON=/app/data/secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON_INLINE={"type":"service_account",...}
# Share each Drive folder with the service account email (Editor).
# GOOGLE_DRIVE_ROOT_FOLDER_ID=...
# Per-taxonomy folder IDs (1 Official … 10 Vehicles) — native API / if compose passes them:
# GOOGLE_DRIVE_FOLDER_1=
# GOOGLE_DRIVE_FOLDER_2=
# GOOGLE_DRIVE_FOLDER_3=
# GOOGLE_DRIVE_FOLDER_4=
# GOOGLE_DRIVE_FOLDER_5=
# GOOGLE_DRIVE_FOLDER_6=
# GOOGLE_DRIVE_FOLDER_7=
# GOOGLE_DRIVE_FOLDER_8=
# GOOGLE_DRIVE_FOLDER_9=
# GOOGLE_DRIVE_FOLDER_10=
# Or JSON map: GOOGLE_DRIVE_FOLDERS={"1":"...","4":"..."}
# On Docker VPS prefer GOOGLE_DRIVE_ROOT_FOLDER_ID (wired in docker-compose.yml).
# OAuth (preferred for Settings → Link Google Drive):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the Google Cloud OAuth client redirect URI exactly:
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/archive/drive/oauth/callback
# Tailscale HTTP:
# GOOGLE_OAUTH_REDIRECT_URI=http://your-host.tailXXXX.ts.net:4000/archive/drive/oauth/callback
# Tailscale HTTPS (Serve :8443) — required when PUBLIC_* use https://:
# GOOGLE_OAUTH_REDIRECT_URI=https://your-host.tailXXXX.ts.net:8443/archive/drive/oauth/callback
# Where to send the browser after a successful link (see PUBLIC_WEB_URL above).
# Legacy/env-only refresh token (Settings OAuth stores per-profile instead):
# GOOGLE_OAUTH_REFRESH_TOKEN=
# Ingest PDF rasterization (optional overrides):
# INGEST_MAX_PAGES=40
# INGEST_PDF_DPI=140
