{
  "id": "/",
  "name": "PersonAI OS",
  "short_name": "PersonAI",
  "description": "Personal AI operating system for finance, legal, medical, and daily briefings",
  "lang": "de-CH",
  "dir": "ltr",
  "start_url": "/profiles/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "any",
  "background_color": "#151816",
  "theme_color": "#2f6f5e",
  "prefer_related_applications": false,
  "related_applications": [],
  "categories": ["productivity", "finance", "health"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/dashboard/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
