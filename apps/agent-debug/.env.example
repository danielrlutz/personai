# Agent Debug inbox (dev chat → Cursor MCP)
PORT=8790
HOST=0.0.0.0
DATA_DIR=./data/agent-debug

# Shared token for LAN / Tailscale. Send as Authorization: Bearer <token>
# or X-Agent-Debug-Token: <token>. Leave empty to disable auth (local only).
AGENT_DEBUG_TOKEN=

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
AGENT_DEBUG_COMPOSE_MODEL=llama3.1:8b
# Optional vision model for image captions (falls back to filename+size)
AGENT_DEBUG_VISION_MODEL=
OLLAMA_VISION_MODEL=maternion/LightOnOCR-2

# Batching: hold "awaiting more" messages this long before auto-flush
AGENT_DEBUG_BATCH_TIMEOUT_MS=90000
# Compose worker poll interval
AGENT_DEBUG_WORKER_MS=2000

# Optional context prepended into composed Cursor prompts
AGENT_DEBUG_CONTEXT_HINT=
# Example:
# AGENT_DEBUG_CONTEXT_HINT=PersonAI OS on debi9 (Tailscale). Profile: Daniel. Prefer local Ollama.
AGENT_DEBUG_VPS_HOST=debi9.tail8175e6.ts.net
AGENT_DEBUG_PROFILE_HINT=

# Base URL the MCP client uses to reach this server
AGENT_DEBUG_URL=http://127.0.0.1:8790
