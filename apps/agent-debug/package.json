    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/batching.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
