    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@cursor/sdk": "^1.0.27"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
