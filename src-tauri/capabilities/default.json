{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default PersonAI OS capabilities (local bundle + Next/static dev server)",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:3000",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:3000/*"
    ]
  },
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default"
  ]
}
