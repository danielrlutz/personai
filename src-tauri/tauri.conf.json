{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PersonAI OS",
  "version": "0.1.0",
  "identifier": "com.personai.os",
  "build": {
    "beforeDevCommand": "pnpm --filter @personai/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @personai/web build",
    "frontendDist": "../apps/web/out"
  },
  "app": {
    "windows": [
      {
        "title": "PersonAI OS",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "../apps/server/dist",
      "../apps/server/prisma",
      "../apps/server/package.json"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
