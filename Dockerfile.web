FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
# Baked into the static export. For Tailscale/phone rebuild with MagicDNS FQDN, e.g.
#   --build-arg NEXT_PUBLIC_API_URL=http://your-host.tailXXXX.ts.net:4000
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY package.json pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
RUN pnpm install --filter @personai/web --frozen-lockfile=false
COPY apps/web ./apps/web
WORKDIR /app/apps/web
RUN pnpm build

FROM nginx:1.27-alpine AS runner
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/out /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
